---
import Layout from "@layouts/Layout.astro";
import { EDUCATION, EXPERIENCE, RESUME, SITE, SKILLS, SOCIAL } from "@config";
---

<Layout title={RESUME.title} description={RESUME.description}>
  <article class="resume wrap">
    <header class="resume-intro">
      <p class="kicker">{SITE.name}</p>
      <h1>{RESUME.headline}</h1>
      <p class="lede">{RESUME.summary}</p>
    </header>

    <section class="resume-block" aria-labelledby="resume-experience">
      <div class="section-head">
        <h2 id="resume-experience">Experience</h2>
      </div>
      <ol class="timeline">
        {
          EXPERIENCE.map((role) => (
            <li>
              <div class="timeline-head">
                <h3>
                  {role.position}
                  <span>{role.company}</span>
                </h3>
                <p>
                  {role.start}–{role.end}
                </p>
              </div>
              {role.points && role.points.length > 0 && (
                <ul>
                  {role.points.map((point) => (
                    <li>{point.text}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="resume-block" aria-labelledby="resume-skills">
      <div class="section-head">
        <h2 id="resume-skills">Skills</h2>
      </div>
      <div class="skill-groups">
        {
          SKILLS.map((group) => (
            <div>
              <h3>{group.name}</h3>
              <ul class="chips">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="resume-block" aria-labelledby="resume-education">
      <div class="section-head">
        <h2 id="resume-education">Education & Certifications</h2>
      </div>
      <ul class="credential-list">
        {EDUCATION.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="resume-cta" aria-labelledby="resume-cta">
      <h2 id="resume-cta">Full resume</h2>
      <p>{RESUME.cta}</p>
      <a class="btn btn-primary" href={`mailto:${SOCIAL.email}`}>Email me</a>
    </section>
  </article>
</Layout>
