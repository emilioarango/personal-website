---
import Points from "@components/Points.astro";
import Outbound from "@components/Outbound.astro";
import Layout from "@layouts/Layout.astro";
import { ABOUT, EXPERIENCE, RESUME, SITE, SKILLS, SOCIAL, WORK } from "@config";
---

<Layout title={RESUME.title} description={RESUME.description}>
  <article class="resume wrap">
    <div class="resume-toolbar no-print">
      <p class="todo">
        <span class="todo-mark">TODO</span>
        <span>{RESUME.todo}</span>
      </p>
      <button class="btn" type="button" id="print-resume">Print</button>
    </div>

    <header class="resume-header">
      <h1>{SITE.name}</h1>
      <p class="resume-role">{SITE.jobTitle}</p>
      <p class="resume-contact">
        <span>Irvine, California</span>
        <a href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</a>
        <Outbound href={SOCIAL.linkedin}>LinkedIn</Outbound>
        <Outbound href={SOCIAL.github}>GitHub</Outbound>
        <a href={SITE.url}>emilioarango.com</a>
      </p>
    </header>

    <section class="resume-block" aria-labelledby="resume-summary">
      <h2 id="resume-summary">Summary</h2>
      <p class="resume-summary">{RESUME.summary}</p>
    </section>

    <section class="resume-block" aria-labelledby="resume-skills">
      <h2 id="resume-skills">Skills</h2>
      <dl class="resume-skills">
        {
          SKILLS.map((group) => (
            <div>
              <dt>{group.name}</dt>
              <dd>{group.items.join(", ")}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="resume-block" aria-labelledby="resume-experience">
      <h2 id="resume-experience">Experience</h2>
      {
        EXPERIENCE.map((role) => (
          <div>
            <div class="resume-role-head">
              <h3>
                {role.position}, {role.company}
              </h3>
              <p>
                {role.start}–{role.end}
              </p>
            </div>
            {role.location && <p class="resume-where">{role.location}</p>}
            <Points points={role.points} />
          </div>
        ))
      }
    </section>

    <section class="resume-block" aria-labelledby="resume-work">
      <h2 id="resume-work">Selected work</h2>
      {
        WORK.map((item) => (
          <div class="resume-work">
            <h3>{item.name}</h3>
            <span class="work-context">{item.context}</span>
            <p>{item.summary}</p>
            {item.links.map((link) => (
              <p>
                <Outbound class="text-link" href={link.href} arrow>
                  {link.label}
                </Outbound>
              </p>
            ))}
            <Points points={item.todos.map((text) => ({ text, todo: true }))} />
          </div>
        ))
      }
    </section>

    <section class="resume-block" aria-labelledby="resume-interests">
      <h2 id="resume-interests">Interests</h2>
      <p class="resume-summary">{ABOUT.interests.join(" · ")}</p>
    </section>
  </article>
</Layout>

<script>
  document.getElementById("print-resume")?.addEventListener("click", () => {
    window.print();
  });
</script>
