---
import Layout from "@layouts/Layout.astro";
import { RESUME, SITE } from "@config";
---

<Layout
  title={`Page not found — ${SITE.name}`}
  description="This page does not exist."
  noindex
>
  <section class="hero" aria-labelledby="not-found-title">
    <div class="wrap">
      <div class="banner">
        <p class="kicker">404</p>
        <h1 id="not-found-title">Page not found.</h1>
        <p class="banner-line">This page doesn't exist, or it has moved.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/">Home</a>
          <a class="btn" href="/homelab">Homelab</a>
          <a class="btn" href={RESUME.href}>{RESUME.label}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
