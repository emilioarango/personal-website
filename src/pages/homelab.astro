---
import HomelabDiagram from "@components/HomelabDiagram.astro";
import Icon from "@components/Icon.astro";
import Layout from "@layouts/Layout.astro";
import {
  HOMELAB_ARCHITECTURE,
  HOMELAB_DECISIONS,
  HOMELAB_FOOTER_LINE,
  HOMELAB_HERO,
  HOMELAB_INCIDENT,
  HOMELAB_META,
  HOMELAB_ROADMAP,
  HOMELAB_STACK,
  HOMELAB_STATS,
  ROADMAP_STATUS_LABEL,
} from "../data/homelab";

const STATUS_PILL = {
  done: "pill--ok",
  "in-progress": "pill--info",
  planned: "",
} as const;

const STAT_ICONS = ["box", "activity", "archive", "heart", "clock"] as const;
---

<Layout title={HOMELAB_META.title} description={HOMELAB_META.description}>
  <article class="homelab">
    <header class="hero homelab-hero">
      <div class="wrap">
        <div class="banner">
          <p class="kicker">{HOMELAB_HERO.kicker}</p>
          <h1>{HOMELAB_HERO.title}</h1>
          <p class="banner-line">{HOMELAB_HERO.subtitle}</p>
        </div>
        <ul class="tile-grid tile-grid--five" aria-label="At a glance">
          {
            HOMELAB_STATS.map((stat, i) => (
              <li class="card tile">
                <p class="tile-label">
                  <Icon name={STAT_ICONS[i % STAT_ICONS.length]} />
                  <span class="tile-status">
                    <span aria-hidden="true">✓</span> OK
                  </span>
                </p>
                <p
                  class={
                    stat.value.length > 8
                      ? "tile-value tile-value--text"
                      : "tile-value"
                  }
                >
                  {stat.value}
                </p>
                <p class="tile-detail">{stat.label}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <section class="section" aria-labelledby="homelab-architecture">
      <div class="wrap">
        <figure class="card panel homelab-figure">
          <div class="panel-head">
            <h2 id="homelab-architecture">Architecture</h2>
          </div>
          <HomelabDiagram variant="full" />
          <figcaption class="sr-only">
            {HOMELAB_ARCHITECTURE.caption}
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section" aria-labelledby="homelab-stack">
      <div class="wrap">
        <div class="card panel homelab-table-card">
          <div class="panel-head">
            <h2 id="homelab-stack">Stack</h2>
          </div>
          <table class="homelab-table">
            <thead>
              <tr>
                <th scope="col">Layer</th>
                <th scope="col">Tool</th>
                <th scope="col">Why</th>
              </tr>
            </thead>
            <tbody>
              {
                HOMELAB_STACK.map((row) => (
                  <tr>
                    <th scope="row" data-label="Layer">
                      {row.layer}
                    </th>
                    <td data-label="Tool">{row.tool}</td>
                    <td data-label="Why">{row.why}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="homelab-decisions">
      <div class="wrap">
        <div class="card panel">
          <div class="panel-head">
            <h2 id="homelab-decisions">Decisions &amp; tradeoffs</h2>
          </div>
          <ol class="homelab-decisions">
            {
              HOMELAB_DECISIONS.map((d) => (
                <li>
                  <h3>{d.title}</h3>
                  <p>{d.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="homelab-incident">
      <div class="wrap">
        <div class="card panel homelab-incident">
          <div class="panel-head">
            <h2 id="homelab-incident">
              <span class="pill pill--warn">Incident</span>
              {HOMELAB_INCIDENT.title}
            </h2>
          </div>
          <dl>
            {
              HOMELAB_INCIDENT.fields.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="homelab-roadmap">
      <div class="wrap">
        <div class="card panel">
          <div class="panel-head">
            <h2 id="homelab-roadmap">Roadmap</h2>
          </div>
          <ul class="row-list">
            {
              HOMELAB_ROADMAP.map((item) => (
                <li class="row">
                  <span class={`pill ${STATUS_PILL[item.status]}`}>
                    {ROADMAP_STATUS_LABEL[item.status]}
                  </span>
                  <div class="row-copy">
                    <h3>{item.name}</h3>
                    {item.detail && <p>{item.detail}</p>}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="section homelab-closing" aria-label="Note">
      <div class="wrap">
        <p>{HOMELAB_FOOTER_LINE}</p>
      </div>
    </section>
  </article>
</Layout>
