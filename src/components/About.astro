---
import { ABOUT } from "@config";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead id="about-title" index="04" title="About" />
    <p class="about-copy">{ABOUT.body}</p>
    <p class="interests">
      <span class="interests-label">Interests</span>
      <span>{ABOUT.interests.join(" · ")}</span>
    </p>
  </div>
</section>
