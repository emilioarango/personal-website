---
import { RESUME } from "@config";
---

<section
  class="section resume-teaser"
  id="resume"
  aria-labelledby="resume-title"
>
  <div class="wrap resume-teaser-layout">
    <div class="section-head">
      <h2 id="resume-title">Résumé</h2>
    </div>
    <div class="resume-teaser-copy">
      <p class="resume-role">{RESUME.headline}</p>
      <p>{RESUME.summary}</p>
      <p>
        <a class="text-link" href={RESUME.href}>View full résumé</a>
      </p>
    </div>
  </div>
</section>
