---
import { SITE, SOCIAL } from "@config";
import Outbound from "./Outbound.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="footer-copy">© {year} {SITE.name}</p>
    <ul>
      <li>
        <Outbound href={`mailto:${SOCIAL.email}`}>Email</Outbound>
      </li>
      <li>
        <Outbound href={SOCIAL.linkedin} me>LinkedIn</Outbound>
      </li>
      <li>
        <Outbound href={SOCIAL.github} me>GitHub</Outbound>
      </li>
      <li>
        <a href="/resume">Résumé</a>
      </li>
    </ul>
    <p class="footer-credit">
      Knight model from
      <Outbound
        href="https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/ABeautifulGame"
        >A Beautiful Game</Outbound
      >, © 2020 ASWF,
      <Outbound href="https://creativecommons.org/licenses/by/4.0/"
        >CC BY 4.0</Outbound
      >; extracted and restyled.
    </p>
  </div>
</footer>
