---
import { SKILLS } from "@config";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <SectionHead id="skills-title" index="01" title="Skills" />
    <div>
      {
        SKILLS.map((group) => (
          <article class="skill">
            <h3>{group.name}</h3>
            <div>
              <ul class="tags">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
              <p>{group.summary}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
