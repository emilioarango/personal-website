---
import { HERO, HERO_TILES, RESUME, SITE, SOCIAL } from "@config";
import Icon from "./Icon.astro";
import Outbound from "./Outbound.astro";
---

<section class="hero" id="overview" aria-labelledby="intro-name">
  <div class="wrap">
    <div class="banner">
      <h1 id="intro-name">Hi, I'm {SITE.name}.</h1>
      <p class="banner-line">{HERO.line}</p>
      <div class="cta-row">
        <Outbound class="btn btn-primary" href={`mailto:${SOCIAL.email}`}>
          Email me
        </Outbound>
        <Outbound class="btn" href={SOCIAL.linkedin}>LinkedIn</Outbound>
        <Outbound class="btn" href={SOCIAL.github}>GitHub</Outbound>
        <a class="btn" href={RESUME.href}>{RESUME.label}</a>
      </div>
    </div>

    <ul class="tile-grid" aria-label="At a glance">
      {
        HERO_TILES.map((tile) => (
          <li class="card tile">
            <p class="tile-label">
              <Icon name={tile.icon} />
              {tile.label}
            </p>
            <p class="tile-value">
              {tile.value}
              {tile.unit && <span class="tile-unit">{tile.unit}</span>}
            </p>
            <p class="tile-detail">{tile.detail}</p>
            {tile.href && (
              <a class="tile-link" href={tile.href}>
                {tile.linkLabel}
                <span aria-hidden="true">›</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
