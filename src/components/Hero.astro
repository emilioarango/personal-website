---
import { HERO, SITE } from "@config";
---

<section class="hero" aria-labelledby="intro-name">
  <div class="knight" data-knight>
    <img
      class="knight-fallback"
      src="/models/knight-fallback.svg"
      alt=""
      width="480"
      height="640"
      decoding="async"
      data-knight-fallback
    />
    <canvas
      class="knight-canvas"
      data-knight-canvas
      tabindex="0"
      role="img"
      aria-label={`Interactive matte black chess knight sculpture for ${SITE.name}. Use arrow keys to rotate.`}
      hidden></canvas>
    <p class="knight-status" data-knight-status hidden>Loading sculpture…</p>
  </div>

  <div class="hero-overlay">
    <h1 id="intro-name" class="hero-name">{SITE.name}</h1>
  </div>

  <p class="hero-tagline">
    {HERO.kicker}
    {HERO.line && <span aria-hidden="true">&middot;</span>}
    {HERO.line}
  </p>

  <p class="knight-hint" data-knight-hint hidden>Drag to rotate</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-knight]");
  const canvas = document.querySelector<HTMLCanvasElement>(
    "[data-knight-canvas]",
  );
  const fallback = document.querySelector<HTMLElement>(
    "[data-knight-fallback]",
  );
  const status = document.querySelector<HTMLElement>("[data-knight-status]");
  const hint = document.querySelector<HTMLElement>("[data-knight-hint]");

  if (root && canvas && fallback && status) {
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    status.hidden = false;
    status.textContent = "Loading sculpture…";

    type Handles = {
      destroy: () => void;
      reset: () => void;
    };
    let handles: Handles | null = null;

    const showFallback = (message?: string) => {
      canvas.hidden = true;
      fallback.removeAttribute("hidden");
      fallback.style.opacity = "1";
      if (hint) hint.hidden = true;
      if (message) {
        status.hidden = false;
        status.textContent = message;
      } else {
        status.hidden = true;
      }
    };

    const showCanvas = () => {
      fallback.style.opacity = "0";
      canvas.hidden = false;
      status.hidden = true;
      if (hint) {
        hint.hidden = false;
        hint.textContent = reducedMotion
          ? "Drag or use arrow keys to rotate"
          : "Drag to rotate";
      }
    };

    import("../scripts/knight-scene")
      .then(({ createKnightScene }) =>
        createKnightScene({
          canvas,
          modelUrl: "/models/staunton-knight.glb",
          reducedMotion,
          onReady: showCanvas,
          onError: () => {
            showFallback("Sculpture unavailable — static view shown.");
          },
        }),
      )
      .then((result) => {
        handles = result;
        if (!result) showFallback("Sculpture unavailable — static view shown.");
      })
      .catch(() => {
        showFallback("Sculpture unavailable — static view shown.");
      });

    window.addEventListener(
      "pagehide",
      () => {
        handles?.destroy();
        handles = null;
      },
      { once: true },
    );
  }
</script>
