---
import { HERO, RESUME, SITE, SOCIAL } from "@config";
import Outbound from "./Outbound.astro";
---

<section class="hero" aria-labelledby="intro-name">
  <div class="wrap hero-layout">
    <div class="hero-copy">
      <p class="kicker">{HERO.kicker}</p>
      <h1 id="intro-name">
        <span class="hi">Hi, I'm</span>
        {SITE.name}.
      </h1>
      <p class="lede">{HERO.line}</p>
      <div class="cta-row">
        <Outbound class="btn btn-primary" href={`mailto:${SOCIAL.email}`}>
          Email me
        </Outbound>
        <Outbound class="btn" href={SOCIAL.linkedin}>LinkedIn</Outbound>
        <Outbound class="btn" href={SOCIAL.github}>GitHub</Outbound>
        <a class="btn" href={RESUME.href}>{RESUME.label}</a>
      </div>
    </div>
    <div class="hero-art">
      <svg class="medallion" viewBox="0 0 160 160" aria-hidden="true">
        <circle cx="80" cy="80" r="76" fill="var(--color-medallion)"></circle>
        <circle
          cx="80"
          cy="80"
          r="71"
          fill="none"
          stroke="var(--color-accent)"
          stroke-width="1.25"
          opacity="0.75"></circle>
        <g fill="var(--color-laurel)">
          <ellipse
