---
import { PROJECTS } from "@config";
import Outbound from "./Outbound.astro";
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="projects-title">Projects</h2>
    </div>
    <div class="project-grid">
      {
        PROJECTS.map((item) => (
          <article class="card project-card">
            <p class="work-context">{item.context}</p>
            <h3>{item.name}</h3>
            <p>{item.summary}</p>
            {item.links.length > 0 && (
              <div class="work-links">
                {item.links.map((link) => (
                  <Outbound class="text-link" href={link.href} arrow>
                    {link.label}
                  </Outbound>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
