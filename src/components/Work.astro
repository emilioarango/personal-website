---
import { PROJECTS, SOCIAL } from "@config";
import { HOMELAB_CARD } from "../data/homelab";
import HomelabDiagram from "./HomelabDiagram.astro";
import Outbound from "./Outbound.astro";
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="card panel">
      <div class="panel-head">
        <h2 id="projects-title">Projects</h2>
        <Outbound class="panel-link" href={SOCIAL.github} arrow>GitHub</Outbound
        >
      </div>
      <article class="card project-featured">
        <div class="project-featured-copy">
          <ul class="pill-row" aria-label="Tags">
            {
              HOMELAB_CARD.tags.map((tag) => (
                <li class="pill pill--info">{tag}</li>
              ))
            }
          </ul>
          <h3>{HOMELAB_CARD.title}</h3>
          <p>{HOMELAB_CARD.summary}</p>
          <p class="project-featured-stats">
            <span class="live-dot" aria-hidden="true"></span>
            {HOMELAB_CARD.stats}
          </p>
          <a class="text-link project-featured-link" href={HOMELAB_CARD.href}>
            {HOMELAB_CARD.linkLabel}
            <span class="arrow" aria-hidden="true">›</span>
          </a>
        </div>
        <div class="project-featured-art" aria-hidden="true">
          <HomelabDiagram variant="compact" />
        </div>
      </article>
      <ul class="row-list">
        {
          PROJECTS.map((item) => (
            <li class="row">
              <span class="pill">{item.context}</span>
              <div class="row-copy">
                <h3>{item.name}</h3>
                <p>{item.summary}</p>
              </div>
              {item.links.length > 0 && (
                <div class="row-links">
                  {item.links.map((link) => (
                    <Outbound class="text-link" href={link.href} arrow>
                      {link.label}
                    </Outbound>
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
