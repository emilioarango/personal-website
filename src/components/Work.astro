---
import { PROJECT_TODO, PROJECTS } from "@config";
import Outbound from "./Outbound.astro";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <SectionHead id="projects-title" index="02" title="Projects" />
    {
      PROJECTS.map((item) => (
        <article class="project-feature">
          <div>
            <p class="work-context">{item.context}</p>
            <h3>{item.name}</h3>
            <p>{item.summary}</p>
            {item.links.length > 0 && (
              <div class="work-links">
                {item.links.map((link) => (
                  <Outbound class="text-link" href={link.href} arrow>
                    {link.label}
                  </Outbound>
                ))}
              </div>
            )}
          </div>
          {item.facts && item.facts.length > 0 && (
            <ul class="project-facts">
              {item.facts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
    <p class="todo project-todo">
      <span class="todo-mark">TODO</span>
      <span>{PROJECT_TODO}</span>
    </p>
  </div>
</section>
