---
import { PROJECTS } from "@config";
import { HOMELAB_CARD } from "../data/homelab";
import HomelabDiagram from "./HomelabDiagram.astro";
import Outbound from "./Outbound.astro";
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="projects-title">Projects</h2>
    </div>
    <article class="card project-card project-featured">
      <div class="project-featured-copy">
        <ul class="project-tags" aria-label="Tags">
          {HOMELAB_CARD.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <h3>{HOMELAB_CARD.title}</h3>
        <p>{HOMELAB_CARD.summary}</p>
        <p class="project-featured-stats">{HOMELAB_CARD.stats}</p>
        <div class="work-links">
          <a class="text-link project-featured-link" href={HOMELAB_CARD.href}>
            {HOMELAB_CARD.linkLabel}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="project-featured-art" aria-hidden="true">
        <HomelabDiagram variant="compact" />
      </div>
    </article>
    <div class="project-grid">
      {
        PROJECTS.map((item) => (
          <article class="card project-card">
            <p class="work-context">{item.context}</p>
            <h3>{item.name}</h3>
            <p>{item.summary}</p>
            {item.links.length > 0 && (
              <div class="work-links">
                {item.links.map((link) => (
                  <Outbound class="text-link" href={link.href} arrow>
                    {link.label}
                  </Outbound>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
