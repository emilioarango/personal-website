---
import { INTERESTS } from "@config";
---

<section
  class="section interest-band"
  id="interests"
  aria-labelledby="interests-title"
>
  <div class="wrap">
    <h2 id="interests-title" class="sr-only">Interests</h2>
    <div class="interest-grid">
      {
        INTERESTS.map((interest, index) => (
          <article class="interest-card">
            <span class="interest-num" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{interest.name}</h3>
            <p>{interest.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
