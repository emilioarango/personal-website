---
import { INTERESTS } from "@config";
import Mark from "./Mark.astro";
---

<section class="section" id="interests" aria-labelledby="interests-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="interests-title">Things I come back to</h2>
    </div>
    <div class="interest-grid">
      {
        INTERESTS.map((interest) => (
          <article class="card interest-card">
            <Mark name={interest.name} />
            <h3>{interest.name}</h3>
            <p>{interest.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
