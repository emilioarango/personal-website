---
/**
 * Hand-built architecture diagram for Homelab1.
 * Colors come only from classes in global.css (CSP blocks inline styles),
 * so the drawing follows the site's light/dark tokens.
 * Each variant ships a wide and a tall drawing; CSS shows one per viewport
 * so labels stay legible on a phone instead of shrinking.
 */
interface Props {
  variant?: "full" | "compact";
}

const { variant = "full" } = Astro.props;

type Kind = "node" | "nas" | "container" | "group" | "pill" | "note";

interface Box {
  kind: Kind;
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  lines?: string[];
  tag?: string;
}

interface Link {
  d: string;
  dashed?: boolean;
  arrow?: boolean;
  label?: string;
  lx?: number;
  ly?: number;
  anchor?: "start" | "middle" | "end";
}

interface Drawing {
  layout: "wide" | "tall";
  viewBox: string;
  boxes: Box[];
  links: Link[];
}

const notes = (x: number, y: number, w: number): Box => ({
  kind: "note",
  x,
  y,
  w,
  h: 128,
  title: "Notes",
  lines: [
    "Remote access is Tailscale only,",
    "with no open ports.",
    "",
    "Alerts: Uptime Kuma + healthchecks.io",
    "→ Discord.",
  ],
});

