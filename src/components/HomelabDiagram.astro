const drawings = variant === "compact" ? compact : full;

const title = "Homelab1 architecture";
const desc =
  variant === "compact"
    ? "Internet to a fiber router. The router links to a NAS at 10G and to Homelab1 at 2.5G. Homelab1 runs Docker stacks for media, monitoring, an Ops bot and a Control Room dashboard."
    : "Internet to a fiber router. The router links at 10G to a NAS for storage, with migration in progress, and at 2.5G to Homelab1, a Mac mini running Docker. Its stacks: Media with Plex and Jellyfin; Monitoring with Uptime Kuma, Prometheus and Grafana; an Ops bot that sends Discord alerts for disk and health; and a LAN-only Control Room dashboard. Remote access is Tailscale only, with no open ports. Alerts flow from Uptime Kuma and healthchecks.io to Discord.";

const centered = (k: Kind) => k === "node" || k === "pill" || k === "nas";
---

<div class={`hd hd--${variant}`}>
  {
    drawings.map((dw) => {
      const id = `hd-${variant}-${dw.layout}`;
      return (
        <svg
          class={`hd-svg hd-svg--${dw.layout}`}
          viewBox={dw.viewBox}
          role="img"
          aria-labelledby={`${id}-title ${id}-desc`}
          preserveAspectRatio="xMidYMid meet"
        >
          <title id={`${id}-title`}>{title}</title>
          <desc id={`${id}-desc`}>{desc}</desc>
          <defs>
            <marker
              id={`${id}-arrow`}
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path class="hd-arrowhead" d="M0 0 L10 5 L0 10 z" />
            </marker>
          </defs>

          {dw.boxes.map((b) => {
            const lines = b.lines ?? [];
            const solo = centered(b.kind) && lines.length === 0;
            return (
              <g class={`hd-${b.kind}`}>
                <rect
                  class="hd-box"
                  x={b.x}
                  y={b.y}
                  width={b.w}
                  height={b.h}
                  rx={b.kind === "pill" ? 12 : 10}
                />
                {solo ? (
                  <text
                    class="hd-title"
                    x={b.x + b.w / 2}
                    y={b.y + b.h / 2}
                    text-anchor="middle"
                    dominant-baseline="central"
                  >
                    {b.title}
                  </text>
                ) : (
                  <text
                    class="hd-title"
                    x={centered(b.kind) ? b.x + b.w / 2 : b.x + 16}
                    y={b.y + 26}
                    text-anchor={centered(b.kind) ? "middle" : "start"}
                  >
                    {b.title}
                  </text>
                )}
                {b.tag && (
                  <text
                    class="hd-tag"
                    x={b.x + b.w - 16}
                    y={b.y + 26}
                    text-anchor="end"
                  >
                    {b.tag}
                  </text>
                )}
                {lines.map((line, i) => (
                  <text
                    class="hd-line"
                    x={centered(b.kind) ? b.x + b.w / 2 : b.x + 16}
                    y={b.y + 48 + i * 19}
                    text-anchor={centered(b.kind) ? "middle" : "start"}
                  >
                    {line}
                  </text>
                ))}
              </g>
            );
          })}

          {dw.links.map((l) => (
            <g class="hd-link">
              <path
                class={l.dashed ? "hd-wire hd-wire--dashed" : "hd-wire"}
                d={l.d}
                marker-end={l.arrow ? `url(#${id}-arrow)` : undefined}
              />
              {l.label && (
                <text
                  class="hd-speed"
                  x={l.lx}
                  y={l.ly}
                  text-anchor={l.anchor ?? "start"}
                >
                  {l.label}
                </text>
              )}
            </g>
          ))}
        </svg>
      );
    })
  }
</div>
