---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span class="interest-mark" aria-hidden="true">
  {
    name === "Chess" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <rect
          x="6.5"
          y="6.5"
          width="19"
          height="19"
          rx="2.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        />
        <path fill="currentColor" d="M8 8h8v8H8zm8 8h8v8h-8z" />
      </svg>
    )
  }
  {
    name === "AI and coding" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path
          fill="currentColor"
          d="M16 3.2 18.1 12.2 27 14.4 18.1 16.6 16 25.6 13.9 16.6 5 14.4 13.9 12.2Z"
        />
        <circle cx="24.5" cy="7.5" r="1.4" fill="currentColor" />
      </svg>
    )
  }
  {
    name === "Film" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <rect
          x="4.5"
          y="7"
          width="23"
          height="18"
          rx="2.2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        />
        <path
          stroke="currentColor"
          stroke-width="1.6"
          d="M4.5 12.2h23M4.5 19.8h23"
        />
        <circle cx="8" cy="9.6" r="1" fill="currentColor" />
        <circle cx="12.2" cy="9.6" r="1" fill="currentColor" />
        <circle cx="16.4" cy="9.6" r="1" fill="currentColor" />
        <circle cx="20.6" cy="9.6" r="1" fill="currentColor" />
        <circle cx="24.8" cy="9.6" r="1" fill="currentColor" />
        <circle cx="8" cy="22.4" r="1" fill="currentColor" />
        <circle cx="12.2" cy="22.4" r="1" fill="currentColor" />
        <circle cx="16.4" cy="22.4" r="1" fill="currentColor" />
        <circle cx="20.6" cy="22.4" r="1" fill="currentColor" />
        <circle cx="24.8" cy="22.4" r="1" fill="currentColor" />
      </svg>
    )
  }
  {
    name === "History" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path fill="currentColor" d="M8 7.2h16v2.1H8zM9.4 5.2h13.2V7H9.4z" />
        <path
          fill="currentColor"
          d="M10.2 23.2h11.6V25H10.2zM8.4 25.2h15.2V27H8.4z"
        />
        <rect x="12.2" y="9.4" width="2.3" height="13.6" fill="currentColor" />
        <rect x="17.5" y="9.4" width="2.3" height="13.6" fill="currentColor" />
      </svg>
    )
  }
  {
    name === "Stoicism" && (
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path
          d="M16 27C16 18 14 12 8 8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <path
          d="M16 27c0-9 2-15 8-19"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <ellipse
          cx="11.2"
          cy="13.2"
          rx="3.3"
          ry="1.55"
          transform="rotate(-42 11.2 13.2)"
          fill="currentColor"
        />
        <ellipse
          cx="12.4"
          cy="18.4"
          rx="3.3"
          ry="1.55"
          transform="rotate(-58 12.4 18.4)"
          fill="currentColor"
        />
        <ellipse
          cx="20.8"
          cy="13.2"
          rx="3.3"
          ry="1.55"
          transform="rotate(42 20.8 13.2)"
          fill="currentColor"
        />
        <ellipse
          cx="19.6"
          cy="18.4"
          rx="3.3"
          ry="1.55"
          transform="rotate(58 19.6 18.4)"
          fill="currentColor"
        />
      </svg>
    )
  }
</span>
