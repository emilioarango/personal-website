---
import { HERO, NAV, SITE } from "@config";
import { BUILD } from "../lib/build";

const path =
  Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const onHome = path === "/";

/** A page tab is current when its path matches; on / the Overview tab starts current. */
function isCurrent(href: string): boolean {
  return !href.includes("#") && href === path;
}

const stamp = BUILD.commit
  ? `Built from personal-website at ${BUILD.commit}, ${BUILD.date}`
  : `Built ${BUILD.date}`;
---

<header class="site-header">
  <div class="wrap header-top">
    <div class="brand-block">
      <a class="brand" href="/">{SITE.name}</a>
      <span class="brand-meta">{stamp}</span>
      <span class="brand-sub">{HERO.kicker}</span>
    </div>
    <div class="header-tools">
      <p class="clock" id="clock" hidden>
        <span class="sr-only">Local time in Southern California: </span>
        <time id="clock-time"></time>
      </p>
      <div class="seg" role="group" aria-label="Theme" id="theme-seg">
        <button type="button" data-theme-choice="auto" aria-pressed="false">
          Auto
        </button>
        <button type="button" data-theme-choice="light" aria-pressed="false">
          Light
        </button>
        <button type="button" data-theme-choice="dark" aria-pressed="true">
          Dark
        </button>
      </div>
    </div>
  </div>
  <nav class="tabs" aria-label="Site">
    <ul class="wrap">
      {
        NAV.map((link) => (
          <li>
            <a
              href={link.href}
              data-section={link.section}
              class={onHome && link.section === "overview" ? "is-active" : ""}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  type Choice = "auto" | "light" | "dark";

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "#theme-seg [data-theme-choice]",
  );
  const meta = document.querySelector<HTMLMetaElement>(
    'meta[name="theme-color"]',
  );
  const scheme = document.querySelector<HTMLMetaElement>(
    'meta[name="color-scheme"]',
  );
  const media = matchMedia("(prefers-color-scheme: dark)");

  // Keep in sync with the pre-paint script in Layout.astro and global.css.
  const colors = { light: "#f5f5f7", dark: "#1c1c1e" };

  function readChoice(): Choice {
    const set = root.dataset.theme;
    return set === "light" || set === "dark" ? set : "auto";
  }

  function paint(choice: Choice) {
    if (choice === "auto") delete root.dataset.theme;
    else root.dataset.theme = choice;
    const dark = choice === "dark" || (choice === "auto" && media.matches);
    if (meta) meta.content = dark ? colors.dark : colors.light;
    if (scheme) scheme.content = choice === "auto" ? "light dark" : choice;
    buttons.forEach((b) =>
      b.setAttribute(
        "aria-pressed",
        b.dataset.themeChoice === choice ? "true" : "false",
      ),
    );
  }

  paint(readChoice());

  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const choice = (b.dataset.themeChoice as Choice) ?? "auto";
      paint(choice);
      try {
        // "auto" is stored explicitly: an empty store means the dark default.
        localStorage.setItem("theme", choice);
      } catch {
        /* Storage can be blocked. The choice still holds for this visit. */
      }
    }),
  );

  media.addEventListener("change", () => {
    if (readChoice() === "auto") paint("auto");
  });

  // Local clock, like the control room's header. Pacific time, minute precision.
  const clock = document.getElementById("clock");
  const clockTime = document.getElementById("clock-time");
  if (clock && clockTime) {
    const fmt = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Los_Angeles",
      weekday: "short",
      day: "numeric",
      month: "short",
      hour: "numeric",
      minute: "2-digit",
      timeZoneName: "short",
    });
    const tick = () => {
      const parts = Object.fromEntries(
        fmt.formatToParts(new Date()).map((p) => [p.type, p.value]),
      );
      clockTime.textContent = `${parts.weekday} ${parts.day} ${parts.month} · ${parts.hour}:${parts.minute} ${parts.dayPeriod} ${parts.timeZoneName}`;
    };
    tick();
    clock.hidden = false;
    setInterval(tick, 30_000);
  }

  // Scroll-spy for the home-page tabs.
  const tabs = document.querySelectorAll<HTMLAnchorElement>(
    ".tabs a[data-section]",
  );
  const sections = [...tabs]
    .map((a) => document.getElementById(a.dataset.section ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    const setActive = (id: string) =>
      tabs.forEach((a) =>
        a.classList.toggle("is-active", a.dataset.section === id),
      );

    const visible = new Map<string, boolean>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
        const first = sections.find((s) => visible.get(s.id));
        if (first) setActive(first.id);
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    sections.forEach((s) => observer.observe(s));

    // Overview is "/": on the home page, scroll instead of reloading.
    tabs.forEach((a) => {
      if (a.dataset.section !== "overview") return;
      a.addEventListener("click", (event) => {
        event.preventDefault();
        history.replaceState(null, "", "/");
        window.scrollTo({ top: 0 });
        setActive("overview");
      });
    });
  }
</script>
