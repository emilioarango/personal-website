---
import { SOCIAL } from "@config";
import Outbound from "./Outbound.astro";
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-layout">
    <div class="section-head">
      <h2 id="contact-title">Contact</h2>
    </div>
    <ul class="contact-list">
      <li>
        <Outbound href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</Outbound>
      </li>
      <li>
        <Outbound href={SOCIAL.linkedin} me>LinkedIn</Outbound>
      </li>
      <li>
        <Outbound href={SOCIAL.github} me>GitHub</Outbound>
      </li>
    </ul>
  </div>
</section>
