---
import { EXPERIENCE } from "@config";
import Points from "./Points.astro";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <SectionHead id="experience-title" index="02" title="Experience" />
    <div>
      {
        EXPERIENCE.map((role) => (
          <article class="role">
            <p class="role-when">
              <time datetime={role.start}>{role.start}</time>
              {"–"}
              {role.end === "Present" ? (
                role.end
              ) : (
                <time datetime={role.end}>{role.end}</time>
              )}
            </p>
            <div>
              <h3>
                {role.position} <span>at {role.company}</span>
              </h3>
              {role.location && <p class="role-meta">{role.location}</p>}
              <Points points={role.points} />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
